# Copy to `.env` and adjust. `.env` is git-ignored and must never be committed.
# These values are consumed by docker-compose.yml for the local PostgreSQL container.

POSTGRES_DB=fretlab
POSTGRES_USER=fretlab
POSTGRES_PASSWORD=fretlab
POSTGRES_PORT=5432

# Backend (read directly by Spring Boot, not by docker-compose).
# The committed application.yml default only works for local development. Generate a real secret
# for any shared or deployed environment, e.g.: openssl rand -base64 48
FRETLAB_JWT_SECRET=local-development-only-secret-change-me-before-deploying-anywhere
FRETLAB_JWT_EXPIRATION_MINUTES=60
